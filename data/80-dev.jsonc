// ferry 映射库 — 开发工具
{
  "commands": [
    {
      "id": "git",
      "category": "dev",
      "summary": "版本控制",
      "names": { "linux": "git", "macos": "git", "freebsd": "git", "windows": "git", "windows_cmd": "git" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "克隆仓库", "status": "equivalent",
          "linux": "git clone https://github.com/u/r.git", "macos": "git clone https://github.com/u/r.git", "freebsd": "git clone https://github.com/u/r.git",
          "windows": "git clone https://github.com/u/r.git",
          "caveats": ["Windows 需先装 Git for Windows；行尾自动转换(eol)可能污染仓库"] },
        { "desc": "查看状态", "status": "equivalent",
          "linux": "git status -sb", "macos": "git status -sb", "freebsd": "git status -sb", "windows": "git status -sb" },
        { "desc": "提交", "status": "equivalent",
          "linux": "git commit -am 'msg'", "macos": "git commit -am 'msg'", "freebsd": "git commit -am 'msg'", "windows": "git commit -am \"msg\"" }
      ]
    },
    {
      "id": "docker",
      "category": "dev",
      "summary": "容器管理",
      "names": { "linux": "docker", "macos": "docker", "freebsd": "docker", "windows": "docker", "windows_cmd": "docker" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "运行容器", "status": "equivalent",
          "linux": "docker run -it --rm ubuntu bash", "macos": "docker run -it --rm ubuntu bash", "freebsd": "docker run -it --rm ubuntu bash",
          "windows": "docker run -it --rm ubuntu bash",
          "caveats": ["Windows/macOS 需 Docker Desktop（或 WSL2 后端），Linux 原生"] },
        { "desc": "查看容器", "status": "equivalent",
          "linux": "docker ps -a", "macos": "docker ps -a", "freebsd": "docker ps -a", "windows": "docker ps -a" },
        { "desc": "挂载当前目录", "status": "approximate",
          "linux": "docker run -v $(pwd):/app img", "macos": "docker run -v $(pwd):/app img", "freebsd": "docker run -v $(pwd):/app img",
          "windows": "docker run -v ${PWD}:/app img",
          "caveats": ["Windows 路径需转成 //c/... 或直接 ${PWD}；Docker Desktop 要求共享该盘"] }
      ]
    },
    {
      "id": "make",
      "category": "dev",
      "summary": "构建工具",
      "names": { "linux": "make", "macos": "make", "freebsd": "make", "windows": "nmake", "windows_cmd": "nmake" },
      "flags": [],
      "recipes": [
        { "desc": "执行默认目标", "status": "approximate",
          "linux": "make", "macos": "make", "freebsd": "make",
          "windows": "nmake",
          "caveats": ["Windows 无 make（可装 MSYS2 的 make 或 mingw32-make）；nmake 用 Visual Studio 工具链"] },
        { "desc": "并行构建", "status": "approximate",
          "linux": "make -j$(nproc)", "macos": "make -j$(sysctl -n hw.ncpu)", "freebsd": "make -j$(sysctl -n hw.ncpu)",
          "windows": "nmake /NOLOGO" }
      ]
    },
    {
      "id": "gcc",
      "category": "dev",
      "summary": "C 编译器",
      "names": { "linux": "gcc", "macos": "clang", "freebsd": "clang", "windows": "cl", "windows_cmd": "cl" },
      "flags": [
        { "semantic": "输出文件", "linux": "-o app", "macos": "-o app", "freebsd": "-o app", "windows": "-Fe:app.exe", "windows_cmd": "" },
        { "semantic": "优化", "linux": "-O2", "macos": "-O2", "freebsd": "-O2", "windows": "/O2", "windows_cmd": "" }
      ],
      "recipes": [
        { "desc": "编译单个 C 文件", "status": "equivalent",
          "linux": "gcc -O2 -o app main.c", "macos": "clang -O2 -o app main.c", "freebsd": "clang -O2 -o app main.c",
          "windows": "cl /O2 /Fe:app.exe main.c",
          "caveats": ["Windows 需 Visual Studio Build Tools；或装 MSYS2 用 gcc"] }
      ]
    },
    {
      "id": "python3",
      "category": "dev",
      "summary": "Python 解释器",
      "names": { "linux": "python3", "macos": "python3", "freebsd": "python3", "windows": "py", "windows_cmd": "py" },
      "flags": [],
      "recipes": [
        { "desc": "运行脚本", "status": "equivalent",
          "linux": "python3 app.py", "macos": "python3 app.py", "freebsd": "python3 app.py",
          "windows": "py app.py", "windows_cmd": "py app.py" },
        { "desc": "建虚拟环境", "status": "equivalent",
          "linux": "python3 -m venv .venv", "macos": "python3 -m venv .venv", "freebsd": "python3 -m venv .venv",
          "windows": "py -m venv .venv" },
        { "desc": "激活虚拟环境", "status": "approximate",
          "linux": "source .venv/bin/activate", "macos": "source .venv/bin/activate", "freebsd": ". .venv/bin/activate",
          "windows": ".\\.venv\\Scripts\\Activate.ps1",
          "caveats": ["PowerShell 可能因执行策略拦脚本：Set-ExecutionPolicy -Scope CurrentUser RemoteSigned"] }
      ]
    },
    {
      "id": "node",
      "category": "dev",
      "summary": "Node.js",
      "names": { "linux": "node", "macos": "node", "freebsd": "node", "windows": "node", "windows_cmd": "node" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "运行脚本", "status": "equivalent",
          "linux": "node app.js", "macos": "node app.js", "freebsd": "node app.js", "windows": "node app.js" }
      ]
    },
    {
      "id": "go",
      "category": "dev",
      "summary": "Go 工具链",
      "names": { "linux": "go", "macos": "go", "freebsd": "go", "windows": "go", "windows_cmd": "go" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "构建", "status": "approximate",
          "linux": "go build -o app ./cmd/app", "macos": "go build -o app ./cmd/app", "freebsd": "go build -o app ./cmd/app",
          "windows": "go build -o app.exe .\\cmd\\app" }
      ]
    },
    {
      "id": "cargo",
      "category": "dev",
      "summary": "Rust 工具链",
      "names": { "linux": "cargo", "macos": "cargo", "freebsd": "cargo", "windows": "cargo", "windows_cmd": "cargo" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "构建 release", "status": "equivalent",
          "linux": "cargo build --release", "macos": "cargo build --release", "freebsd": "cargo build --release",
          "windows": "cargo build --release" }
      ]
    },
    {
      "id": "npx", "category": "dev", "summary": "npx 临时执行 npm 包命令",
      "names": { "linux": "npx", "macos": "npx", "freebsd": "npx", "windows": "npx", "windows_cmd": "npx" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "临时跑一个包", "status": "equivalent",
          "linux": "npx serve -l 3000", "macos": "npx serve -l 3000", "freebsd": "npx serve -l 3000",
          "windows": "npx serve -l 3000", "windows_cmd": "npx serve -l 3000",
          "caveats": ["npm scripts 场景注意：Windows 上 npm 脚本用 cmd 不是 sh（见 js-npm-scripts-shell）"] }
      ]
    },
    {
      "id": "strings", "category": "dev", "summary": "提取二进制中的可打印字符串",
      "names": { "linux": "strings", "macos": "strings", "freebsd": "strings", "windows": "", "windows_cmd": "" },
      "flags": [],
      "recipes": [
        { "desc": "列出二进制内字符串", "status": "unsupported",
          "linux": "strings app.exe", "macos": "strings app.exe", "freebsd": "strings app.exe",
          "windows": "",
          "caveats": ["Windows 无原生 strings；PowerShell 等价写法：Get-Content app.exe -Encoding Byte -ReadCount 0 等不可靠，建议用 python -c \"import sys;d=open(sys.argv[1],'rb').read();print(''.join(chr(b) if 32<=b<127 else '\\n' for b in d))\" 粗筛，或装 Sysinternals strings.exe"] }
      ]
    },
    {
      "id": "route", "category": "net", "summary": "查看/操作路由表",
      "names": { "linux": "ip route", "macos": "netstat -r", "freebsd": "netstat -r", "windows": "Get-NetRoute", "windows_cmd": "route" },
      "flags": [
        { "semantic": "打印 IPv4 路由表", "linux": "ip route show", "macos": "netstat -rn", "freebsd": "netstat -rn", "windows": "Get-NetRoute -AddressFamily IPv4", "windows_cmd": "route print -4" },
        { "semantic": "加静态路由", "linux": "ip route add 10.0.0.0/8 via 192.168.1.1", "macos": "route -n add -net 10.0.0.0/8 192.168.1.1", "freebsd": "route add -net 10.0.0.0/8 192.168.1.1", "windows": "New-NetRoute -DestinationPrefix 10.0.0.0/8 -NextHop 192.168.1.1", "windows_cmd": "route add 10.0.0.0 mask 255.0.0.0 192.168.1.1" }
      ],
      "recipes": []
    },
    {
      "id": "openssl", "category": "net", "summary": "TLS/加密工具（版本方言大）",
      "names": { "linux": "openssl", "macos": "openssl", "freebsd": "openssl", "windows": "openssl", "windows_cmd": "openssl" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "测试 TLS 握手", "status": "equivalent",
          "linux": "openssl s_client -connect host:443 -servername host", "macos": "openssl s_client -connect host:443 -servername host", "freebsd": "openssl s_client -connect host:443 -servername host",
          "windows": "openssl s_client -connect host:443 -servername host", "windows_cmd": "openssl s_client -connect host:443 -servername host",
          "caveats": ["macOS 自带 LibreSSL 老版，部分新子命令/参数缺失；各平台版本差异大，输出解析前先看 openssl version"] }
      ]
    },
    {
      "id": "cmake", "category": "dev", "summary": "CMake 构建系统",
      "names": { "linux": "cmake", "macos": "cmake", "freebsd": "cmake", "windows": "cmake", "windows_cmd": "cmake" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "配置生成器差异", "status": "approximate",
          "linux": "cmake -S . -B build", "macos": "cmake -S . -B build", "freebsd": "cmake -S . -B build",
          "windows": "cmake -S . -B build -G \"Visual Studio 17 2022\"",
          "caveats": ["默认生成器不同（Linux=Unix Makefiles，Windows=VS/ Ninja 需显式指定）；路径含反斜杠与空格时引号规则不同"] }
      ]
    },
    {
      "id": "ffmpeg", "category": "dev", "summary": "音视频处理",
      "names": { "linux": "ffmpeg", "macos": "ffmpeg", "freebsd": "ffmpeg", "windows": "ffmpeg", "windows_cmd": "ffmpeg" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "抽帧", "status": "equivalent",
          "linux": "ffmpeg -i in.mp4 -vf select='eq(n,30)' -vsync vfr frame_%d.png",
          "macos": "ffmpeg -i in.mp4 -vf select='eq(n,30)' -vsync vfr frame_%d.png",
          "freebsd": "ffmpeg -i in.mp4 -vf select='eq(n,30)' -vsync vfr frame_%d.png",
          "windows": "ffmpeg -i in.mp4 -vf select='eq(n,30)' -vsync vfr frame_%d.png", "windows_cmd": "ffmpeg -i in.mp4 -vf select='eq(n,30)' -vsync vfr frame_%d.png",
          "caveats": ["引号内的单引号在 cmd.exe 需改双引号；输出路径反斜杠"] }
      ]
    },
    {
      "id": "scoop", "category": "pkg", "summary": "Windows 包管理器（对应 brew/apt）",
      "names": { "linux": "apt", "macos": "brew", "freebsd": "pkg", "windows": "scoop", "windows_cmd": "scoop" },
      "flags": [
        { "semantic": "搜索包", "linux": "apt search name", "macos": "brew search name", "freebsd": "pkg search name", "windows": "scoop search name", "windows_cmd": "scoop search name" },
        { "semantic": "安装包", "linux": "apt install name", "macos": "brew install name", "freebsd": "pkg install name", "windows": "scoop install name", "windows_cmd": "scoop install name" }
      ],
      "recipes": []
    },
    {
      "id": "code", "category": "dev", "summary": "VS Code 命令行",
      "names": { "linux": "code", "macos": "code", "freebsd": "", "windows": "code", "windows_cmd": "code" },
      "universal": true,
      "flags": [],
      "recipes": [
        { "desc": "打开目录/文件", "status": "approximate",
          "linux": "code .", "macos": "code .", "freebsd": "", "windows": "code .", "windows_cmd": "code .",
          "caveats": ["macOS 默认不装 code 命令，需在 VS Code 里 Cmd+Shift+P 执行 Shell Command: Install 'code' command in PATH"] }
      ]
    }
  ]
}
