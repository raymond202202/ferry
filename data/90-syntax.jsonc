// ferry 映射库 — Shell 语法差异 + 跨平台已知坑（非命令，用于 prompt-export / syntax / pitfalls）
{
  "commands": [],
  "syntax": [
    {
      "id": "pipe", "summary": "管道", "status": "approximate",
      "linux": "cmd1 | cmd2", "macos": "cmd1 | cmd2", "freebsd": "cmd1 | cmd2",
      "windows": "cmd1 | cmd2", "windows_cmd": "cmd1 | cmd2",
      "note": "语法相同，但 PowerShell 管道传的是对象而非文本，grep/awk 式处理要换成 Where-Object / Select-Object"
    },
    {
      "id": "and-and", "summary": "顺序执行（前一个成功才继续）", "status": "approximate",
      "linux": "cmd1 && cmd2", "macos": "cmd1 && cmd2", "freebsd": "cmd1 && cmd2",
      "windows": "cmd1; if ($?) { cmd2 }", "windows_cmd": "cmd1 && cmd2",
      "note": "PowerShell 5.1 不支持 &&，PS7+ 才支持"
    },
    {
      "id": "or-or", "summary": "前一个失败才执行", "status": "approximate",
      "linux": "cmd1 || cmd2", "macos": "cmd1 || cmd2", "freebsd": "cmd1 || cmd2",
      "windows": "cmd1; if (-not $?) { cmd2 }", "windows_cmd": "cmd1 || cmd2",
      "note": "PowerShell 5.1 不支持 ||"
    },
    {
      "id": "semicolon", "summary": "顺序执行（忽略结果）", "status": "equivalent",
      "linux": "cmd1; cmd2", "macos": "cmd1; cmd2", "freebsd": "cmd1; cmd2",
      "windows": "cmd1; cmd2", "windows_cmd": "cmd1 & cmd2"
    },
    {
      "id": "redirect-out", "summary": "重定向到文件", "status": "equivalent",
      "linux": "cmd > out.txt", "macos": "cmd > out.txt", "freebsd": "cmd > out.txt",
      "windows": "cmd > out.txt", "windows_cmd": "cmd > out.txt"
    },
    {
      "id": "redirect-err", "summary": "合并 stderr 到 stdout", "status": "equivalent",
      "linux": "cmd 2>&1", "macos": "cmd 2>&1", "freebsd": "cmd 2>&1",
      "windows": "cmd 2>&1", "windows_cmd": "cmd 2>&1"
    },
    {
      "id": "devnull", "summary": "丢弃输出", "status": "equivalent",
      "linux": "cmd > /dev/null 2>&1", "macos": "cmd > /dev/null 2>&1", "freebsd": "cmd > /dev/null 2>&1",
      "windows": "cmd > $null 2>&1", "windows_cmd": "cmd > NUL 2>&1"
    },
    {
      "id": "env-var", "summary": "引用环境变量", "status": "equivalent",
      "linux": "$FOO 或 ${FOO}", "macos": "$FOO 或 ${FOO}", "freebsd": "$FOO 或 ${FOO}",
      "windows": "$env:FOO", "windows_cmd": "%FOO%"
    },
    {
      "id": "env-assign", "summary": "设置环境变量", "status": "equivalent",
      "linux": "export FOO=bar", "macos": "export FOO=bar", "freebsd": "export FOO=bar",
      "windows": "$env:FOO = 'bar'", "windows_cmd": "set FOO=bar"
    },
    {
      "id": "cmd-subst", "summary": "命令替换", "status": "equivalent",
      "linux": "$(cmd) 或 `cmd`", "macos": "$(cmd) 或 `cmd`", "freebsd": "$(cmd) 或 `cmd`",
      "windows": "$(cmd)", "windows_cmd": "for /f %i in ('cmd') do ...",
      "note": "PowerShell 用 $( ) ，反引号在 PS 里是转义符不是命令替换"
    },
    {
      "id": "var-assign", "summary": "局部变量赋值", "status": "equivalent",
      "linux": "NAME=value", "macos": "NAME=value", "freebsd": "NAME=value",
      "windows": "$Name = 'value'", "windows_cmd": "set NAME=value"
    },
    {
      "id": "exit-code", "summary": "上一条命令的退出码", "status": "equivalent",
      "linux": "$?", "macos": "$?", "freebsd": "$?",
      "windows": "$LASTEXITCODE（外部程序）/ $?（cmdlet 布尔）", "windows_cmd": "%ERRORLEVEL%"
    },
    {
      "id": "glob", "summary": "通配符展开", "status": "approximate",
      "linux": "*.log（shell 展开）", "macos": "*.log（shell 展开）", "freebsd": "*.log（shell 展开）",
      "windows": "*.log（多数 cmdlet 内部处理，非 shell 展开）", "windows_cmd": "*.log（程序自己处理）",
      "note": "POSIX 由 shell 展开后传给程序；Windows 多数情况由程序自己解释通配符"
    },
    {
      "id": "quoting", "summary": "引号与转义", "status": "approximate",
      "linux": "'literal' \"$expanded\" 反斜杠转义", "macos": "'literal' \"$expanded\" 反斜杠转义", "freebsd": "'literal' \"$expanded\" 反斜杠转义",
      "windows": "'literal' \"$expanded\" 反引号 ` 转义", "windows_cmd": "无单引号；双引号内 % 仍展开",
      "note": "PowerShell 单引号内不解析变量；反斜杠不是转义符，反引号才是"
    },
    {
      "id": "background", "summary": "后台执行", "status": "approximate",
      "linux": "cmd &", "macos": "cmd &", "freebsd": "cmd &",
      "windows": "Start-Job { cmd } 或 Start-Process", "windows_cmd": "start /b cmd"
    },
    {
      "id": "heredoc", "summary": "多行输入", "status": "unsupported",
      "linux": "cmd <<EOF ... EOF", "macos": "cmd <<EOF ... EOF", "freebsd": "cmd <<EOF ... EOF",
      "windows": null, "windows_cmd": null,
      "note": "PowerShell 无 heredoc；用 here-string @\" ... \"@ 作为输入"
    },
    {
      "id": "subshell", "summary": "子 shell / 命令组", "status": "approximate",
      "linux": "( cmd1; cmd2 )", "macos": "( cmd1; cmd2 )", "freebsd": "( cmd1; cmd2 )",
      "windows": "& { cmd1; cmd2 }", "windows_cmd": "cmd /c \"cmd1 & cmd2\""
    },
    {
      "id": "brace-expand", "summary": "大括号扩展", "status": "unsupported",
      "linux": "cp a.{txt,bak}", "macos": "cp a.{txt,bak}（zsh 支持）", "freebsd": "cp a.txt a.txt.bak",
      "windows": null, "windows_cmd": null,
      "note": "PowerShell 无大括号扩展；bash 支持，sh/dash 不支持"
    },
    {
      "id": "tilde", "summary": "家目录缩写 ~", "status": "equivalent",
      "linux": "~/app", "macos": "~/app", "freebsd": "~/app",
      "windows": "~\\app（PS 支持）或 $env:USERPROFILE\\app", "windows_cmd": "%USERPROFILE%\\app"
    },
    {
      "id": "path-sep", "summary": "路径分隔符", "status": "approximate",
      "linux": "/", "macos": "/", "freebsd": "/",
      "windows": "\\（PS 也接受 /）", "windows_cmd": "\\"
    },
    {
      "id": "case-sensitivity", "summary": "大小写敏感", "status": "approximate",
      "linux": "文件名敏感、命令名敏感", "macos": "文件名默认不敏感（APFS）、命令名敏感", "freebsd": "UFS/ZFS 默认大小写敏感、命令名敏感",
      "windows": "文件名不敏感、命令名不敏感", "windows_cmd": "均不敏感",
      "note": "跨平台脚本里文件名一律按敏感处理最安全"
    },
    {
      "id": "line-ending", "summary": "行尾符", "status": "unsupported",
      "linux": "LF", "macos": "LF", "freebsd": "LF",
      "windows": "CRLF", "windows_cmd": "CRLF",
      "note": "CRLF 的 .sh 在 Linux 上会报 bad interpreter: /bin/bash^M，用 dos2unix 或 sed -i 's/\\r//' 修"
    },
    {
      "id": "encoding", "summary": "默认编码", "status": "approximate",
      "linux": "UTF-8", "macos": "UTF-8", "freebsd": "UTF-8",
      "windows": "PS 5.1 默认 ANSI(GBK)/ 输出 UTF-16；PS7 默认 UTF-8", "windows_cmd": "OEM 代码页（中文 936）",
      "note": "Windows 上读写中文必设 [Console]::OutputEncoding = [Text.UTF8Encoding]::new() 或 chcp 65001"
    },
    {
      "id": "sudo", "summary": "提权执行", "status": "approximate",
      "linux": "sudo cmd", "macos": "sudo cmd", "freebsd": "su -  # 切到 root 后再执行（FreeBSD base 无 sudo/doas）",
      "windows": "Start-Process -Verb RunAs", "windows_cmd": "runas /user:Administrator cmd",
      "note": "Windows 无 sudo（Win11 24H2 起有 sudo 但默认关闭）；多数操作需管理员终端"
    }
  ],
  "pitfalls": [
    {
      "id": "py-subprocess-encoding", "platforms": ["windows"],
      "title": "Python subprocess 在中文 Windows 上采集输出必须容错解码",
      "detail": "中文 Windows 控制台默认 GBK（cp936），subprocess.run(text=True) 用 UTF-8 解码会抛 UnicodeDecodeError 使程序崩溃；纯 ASCII 环境下恰好能过，纯靠环境巧合。实测：ferry 自身 drills 就因此崩过。",
      "fix": "字节采集 + decode('utf-8', errors='replace')；或 subprocess.run(..., encoding='utf-8', errors='replace')。"
    },
    {
      "id": "py-open-newline", "platforms": ["windows", "linux", "macos", "freebsd"],
      "title": "open(...,'w') 换行符各平台不一致",
      "detail": "文本模式写文件：Windows 默认写入 \\r\\n（会把 CR 混进 shell 脚本/JSON/配置），POSIX 是 \\n。生成跨平台要用的脚本文件时 CR 会导致 bash 报错 / JSON 校验失败。",
      "fix": "生成给非 Windows 工具消费的文件时显式 newline=''（或 newline='\\n'）；通用场景读文本用 newline=None 自动归一化。"
    },
    {
      "id": "py-python3-name", "platforms": ["windows"],
      "title": "Windows 原生无 python3 命令",
      "detail": "Linux/macOS 的 python3 在 Windows 原生是 python 或 py -3（py 启动器自动选已装版本）。python3 只在 Git Bash 环境碰巧可用，换 cmd/PowerShell/裸机器就失效。",
      "fix": "Windows 上写 py -3 或 python；需要稳定时先 where python 探测，或 shutil.which('python3') or shutil.which('py') 自适配。"
    },
    {
      "id": "py-tmp-path", "platforms": ["windows"],
      "title": "/tmp/ 在 Windows 原生不存在",
      "detail": "-o /tmp/x.js 这种写法只在 Git Bash（映射到用户临时目录）碰巧能用；cmd/PowerShell/裸 Windows 会写到磁盘根目录失败或创建 C:\\tmp（用户可能无权限）。",
      "fix": "Python 内用 tempfile.gettempdir()；shell 里写 $TMPDIR（Git Bash）或 $env:TEMP（PowerShell）；或直接用工作目录相对路径。"
    },
    {
      "id": "py-platform-modules", "platforms": ["linux", "macos", "freebsd", "windows"],
      "title": "平台专属 Python 模块互不可用",
      "detail": "winreg / msvcrt 仅 Windows；pwd / grp / fcntl / termios 仅 POSIX。凭训练环境记忆直接 import，换平台即 ImportError。",
      "fix": "运行时判断：if os.name=='nt' 走 winreg，else 走 pwd 等替代；或 sys.platform.startswith('win') 分支。环境探测类脚本优先选跨平台库（psutil/pathlib）。"
    },
    {
      "id": "json-bom-parse", "platforms": ["windows"],
      "title": "Windows 产生的 JSON 带 BOM，json.loads 直接报错",
      "detail": "PowerShell 重定向（> file.json）、记事本保存的文件常带 UTF-8 BOM（EF BB BF）。python json.loads(open(f).read()) 报 JSONDecodeError: Expecting value，Node JSON.parse 同样炸，且报错信息完全看不出是 BOM 问题。Windows PowerShell 5.1 的 Out-File 默认还是 UTF-16LE。",
      "fix": "Python 读文件用 encoding='utf-8-sig'（自动剥 BOM）；Node 用 fs.readFileSync + text.replace(/^\uFEFF/,'') 后再 parse；写文件时避免 PowerShell 重定向，用程序写。"
    },
    {
      "id": "js-path-join", "platforms": ["windows", "linux", "macos", "freebsd"],
      "title": "JS 里字符串拼路径用 / 会在 Windows 出问题",
      "detail": "dir + '/' + file 在 Windows 大多能侥幸工作（API 容忍正斜杠），但传给原生命令行、某些原生模块（fs 的 old API、child_process 参数）时会因反斜杠语义失败；反过来 '\\' 硬拼在 POSIX 是非法转义。",
      "fix": "统一 path.join(dir, file) / path.resolve；需要字符串分隔符用 path.sep；URL 场景用 POSIX 风格另说，但绝不用加号拼斜杠的写法。"
    },
    {
      "id": "js-npm-scripts-shell", "platforms": ["windows"],
      "title": "package.json scripts 在 Windows 用的不是 sh",
      "detail": "npm scripts 在 Linux/macOS 由 sh 执行，Windows 默认 cmd.exe。脚本里写 NODE_ENV=prod node app.js、cp -r、rm -rf、&& 链接的 POSIX 命令在 Windows 全部失败（NODE_ENV= 在 cmd 是语法错误）。",
      "fix": "环境变量用 cross-env 包；文件操作写 Node 内联（node -e）或用跨平台包（shx：shx rm -rf）；或 scripts 字段写纯 node 调用不依赖 shell 语法。"
    },
    {
      "id": "js-process-platform", "platforms": ["windows", "linux", "macos"],
      "title": "Node 判断平台要认 win32 不是 windows",
      "detail": "process.platform 在 Windows 返回 'win32'（64 位也是），不是 'windows'；process.platform==='win32' / os.platform() 分支是标准写法。凭直觉写 ==='windows' 永远不命中。",
      "fix": "process.platform === 'win32' 判断 Windows；darwin=macOS，linux=Linux，freebsd=FreeBSD。需要看 CPU 架构用 process.arch。"
    },
    {
      "id": "py-open-newline-dual", "platforms": ["windows"],
      "title": "生成的脚本文件 Windows 换行会让 POSIX 工具报错（含 JSON）",
      "detail": "在 Windows 上生成的 .sh/.py/.json 文件如果是 CRLF，scp 到 Linux 后 bash 执行报 $'\r': command not found，JSON 校验器报非法字符。Python open(...,'w') 默认平台换行是根因之一（见 py-open-newline）。",
      "fix": "生成文件显式 newline=''；传输后 dos2unix 或 sed -i 's/\r$//'；读入侧 strip '\\r'。判断文件是否 CRLF：file 命令或 python 检查 b'\\r\\n' in head。"
    },
    {
      "id": "bsd-sed-inplace", "platforms": ["macos", "freebsd"],
      "title": "BSD sed 的 -i 必须带备份后缀",
      "detail": "macOS 与 FreeBSD 的 sed 都是 BSD 版，`sed -i 's/a/b/' f` 会把 's/a/b/' 当成备份后缀，报错或产生垃圾文件；`sed -i '.bak'` 则留下 f.bak。",
      "fix": "写成 sed -i '' 's/a/b/' f（空串=不备份）；或 macOS 用 brew install gnu-sed / FreeBSD 用 pkg install gsed 后调用 gsed。"
    },
    {
      "id": "macos-missing-tools", "platforms": ["macos"],
      "title": "macOS 默认缺少一批 GNU 工具",
      "detail": "timeout、watch、free、nproc、sha256sum、md5sum、wget、tree、column、realpath(旧版) 都不存在或有差异。",
      "fix": "brew install coreutils findutils gnu-sed grep gawk watch wget tree moreutils，GNU 版带 g 前缀（gtimeout/gnproc/gsort）。"
    },
    {
      "id": "bash-32-macos", "platforms": ["macos"],
      "title": "macOS 自带 bash 是 3.2（2007 年）",
      "detail": "不支持关联数组、${var,,}、mapfile；默认 shell 是 zsh。脚本写 #!/bin/bash 在 macOS 上行为可能不同。",
      "fix": "脚本用 #!/usr/bin/env bash 并在需要时 brew install bash；或统一按 POSIX sh 写。"
    },
    {
      "id": "gnu-grep-p", "platforms": ["macos", "freebsd"],
      "title": "BSD grep 不支持 -P（PCRE）",
      "detail": "grep -P '\\d+' 在 macOS 与 FreeBSD 上都是 invalid option。BSD grep 也不支持 --include 的某些写法。",
      "fix": "macOS brew install grep / FreeBSD pkg install gnugrep 后用 ggrep -P；或改用 grep -E 的 POSIX 正则（[0-9]+）。"
    },
    {
      "id": "stat-dialect", "platforms": ["macos", "freebsd", "linux"],
      "title": "stat 参数两套方言",
      "detail": "Linux: stat -c '%s' f；macOS 与 FreeBSD（BSD 版 stat）: stat -f '%z' f。互相照抄必然失败。",
      "fix": "按平台分支写；跨平台脚本用 python3 -c 'import os,sys;print(os.path.getsize(sys.argv[1]))'。"
    },
    {
      "id": "date-d", "platforms": ["macos", "freebsd"],
      "title": "BSD date 没有 -d",
      "detail": "date -d '2026-01-01' +%s 在 macOS 与 FreeBSD 都无效（BSD date 没有 -d）。",
      "fix": "解析用 date -j -f '%Y-%m-%d' '2026-01-01' +%s；epoch 反解用 date -r 1700000000；偏移用 date -v-1d。"
    },
    {
      "id": "readlink-f", "platforms": ["macos"],
      "title": "BSD readlink 没有 -f",
      "detail": "readlink -f 在 macOS 不可用（旧版本）。",
      "fix": "用 realpath（10.13+，需 sw_vers 确认）或 perl -MCwd -e 'print abs_path($ARGV[0])'。"
    },
    {
      "id": "sort-v", "platforms": ["macos"],
      "title": "sort -V 依赖系统版本",
      "detail": "旧版 BSD sort 不认识 -V（illegal option）；macOS 15+ 实测支持（GitHub Actions macOS runner 通过）。",
      "fix": "先直接试 sort -V；报错再 brew install coreutils 用 gsort -V，或在脚本里自己解析。"
    },
    {
      "id": "cp-a-macos", "platforms": ["macos"],
      "title": "旧版 macOS 的 cp 不支持 -a",
      "detail": "cp -a（归档模式）在 macOS 13 之前不被支持。",
      "fix": "用 cp -R -p；或 ditto（macOS 原生，保留元数据）。"
    },
    {
      "id": "ps51-andand", "platforms": ["windows"],
      "title": "PowerShell 5.1 不支持 && 和 ||",
      "detail": "Windows 自带的是 PS 5.1，&& 会报 ParserError；PS7+ 才支持。",
      "fix": "用 ; if ($?) { ... } 结构，或安装 PowerShell 7 并显式用 pwsh。"
    },
    {
      "id": "ps-param-abbrev", "platforms": ["windows"],
      "title": "PowerShell 参数可缩写、不区分大小写",
      "detail": "-Rec 会被解析为 -Recurse，-f 可能歧义报错。命令名大小写也不敏感。",
      "fix": "脚本里参数写全称，避免缩写带来的歧义。"
    },
    {
      "id": "win-encoding", "platforms": ["windows"],
      "title": "Windows 控制台编码不是 UTF-8",
      "detail": "PS 5.1 默认按 ANSI 解码外部程序输出，中文会乱码；重定向文件可能变 UTF-16。",
      "fix": "[Console]::OutputEncoding=[Text.UTF8Encoding]::new(); $OutputEncoding=[Text.UTF8Encoding]::new()；或 chcp 65001。"
    },
    {
      "id": "win-path-limit", "platforms": ["windows"],
      "title": "Windows 路径 260 字符限制",
      "detail": "深目录/长文件名会报 PathTooLongException（除非启用 LongPathsEnabled）。",
      "fix": "注册表 HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem\\LongPathsEnabled=1，或用 \\\\?\\ 前缀。"
    },
    {
      "id": "win-invalid-chars", "platforms": ["windows"],
      "title": "NTFS 禁用字符与保留名",
      "detail": ": * ? \" < > | 不能出现在文件名；CON/PRN/AUX/NUL/COM1 是保留名。",
      "fix": "生成文件名前做白名单过滤。"
    },
    {
      "id": "rm-no-trash", "platforms": ["windows", "linux", "macos", "freebsd"],
      "title": "命令行删除不进回收站",
      "detail": "rm -rf / Remove-Item -Recurse -Force 都是永久删除，不可恢复。",
      "fix": "危险操作前先 dry-run 打印命中列表；或 Windows 用 Recycle 模块，Linux 用 trash-cli。"
    },
    {
      "id": "symlink-perm", "platforms": ["windows"],
      "title": "Windows 符号链接需权限",
      "detail": "New-Item -ItemType SymbolicLink 需管理员权限或开启开发者模式；mklink 参数顺序与 ln 相反。",
      "fix": "开启开发者模式，或以管理员运行；顺序是 mklink 链接 目标。"
    },
    {
      "id": "crlf-script", "platforms": ["linux", "macos", "freebsd", "windows"],
      "title": "CRLF 破坏 shell 脚本",
      "detail": "Windows 编辑过的 .sh 在 Linux 报 /bin/bash^M: bad interpreter。",
      "fix": "git config core.autocrlf input；已有文件用 dos2unix 或 sed -i 's/\\r$//'。"
    },
    {
      "id": "zsh-default", "platforms": ["macos"],
      "title": "macOS 默认 shell 是 zsh",
      "detail": "写进 ~/.bashrc 的别名/环境变量在 zsh 里不生效；zsh 也不做无引号变量分词。",
      "fix": "macOS 上写 ~/.zshrc；两者都要兼容就抽到 ~/.profile 并在两个 rc 里 source。"
    },
    {
      "id": "service-models", "platforms": ["linux", "macos", "freebsd", "windows"],
      "title": "四套完全不同的服务模型",
      "detail": "Linux=systemd unit；macOS=launchd plist（brew services 是包装）；FreeBSD=rc.d 脚本 + /etc/rc.conf 开关（service X start / sysrc X_enable=YES）；Windows=SCM 服务。没有通用命令。",
      "fix": "分别用 systemctl / launchctl(bootstrap) / service+sysrc / New-Service+sc.exe；跨平台产品自带安装器时优先用它注册服务。"
    },
    {
      "id": "wsl-paths", "platforms": ["windows"],
      "title": "WSL 与原生 Windows 路径互转",
      "detail": "WSL 里 C:\\Users → /mnt/c/Users；Linux 侧 / 不等于 Windows 的 C:\\。",
      "fix": "用 wslpath -a/-u 转换；ferry translate 加 --path-style wsl|msys 控制反向映射写法。"
    },
    {
      "id": "hidden-files", "platforms": ["windows", "linux", "macos", "freebsd"],
      "title": "隐藏文件机制不同",
      "detail": "POSIX 靠文件名前缀点号；Windows 靠文件属性（Hidden），ls -a 与 Get-ChildItem -Force 不等价。",
      "fix": "Windows 上还得看 attributes；跨平台遍历时两边都显式包含。"
    },
    {
      "id": "case-fs", "platforms": ["macos", "windows"],
      "title": "文件系统默认大小写不敏感",
      "detail": "macOS(APFS 默认)/Windows 上 Foo.txt 与 foo.txt 是同一个文件，Linux 上是两个。",
      "fix": "发布脚本注意撞名；CI 在 Linux 上跑能提前暴露问题。"
    },
    {
      "id": "freebsd-minimal-base", "platforms": ["freebsd"],
      "title": "FreeBSD base 极简：shell 工具齐全，应用工具靠 pkg",
      "detail": "base 自带 fetch/nc/tar/bsdtar/unzip/zstd/sha256/sha512/md5/openssl/realpath/nproc/timeout/which/sed/awk/grep/find/xargs/install；但没有 curl、wget、git、python3、node、jq、vim、tmux、tree、lsof、rsync、zip、7z、shuf、sudo、doas。命令找不到时先 pkg install，不要以为系统坏了。",
      "fix": "pkg install -y curl git python3 node22 jq vim tmux tree lsof rsync zip 7-Zip；下载单文件可以直接用 base 的 fetch（fetch -r 支持续传）。"
    },
    {
      "id": "freebsd-sh-not-bash", "platforms": ["freebsd"],
      "title": "FreeBSD 默认 /bin/sh，不是 bash",
      "detail": "/bin/sh 是 FreeBSD sh（Almquist 派生）：没有 bash 的数组、[[ ]]、mapfile，也不做花括号扩展——echo a{1,2} 原样输出 a{1,2}。base 里根本没有 bash，#!/bin/bash 的脚本会 bad interpreter。",
      "fix": "脚本写 #!/bin/sh 并只用 POSIX 语法（多个文件用 cp a.txt a.txt.bak 而不是 cp a.{txt,bak}）；确实需要 bash 就 pkg install bash 并显式写 #!/usr/local/bin/bash。"
    },
    {
      "id": "freebsd-pkg-bootstrap", "platforms": ["freebsd"],
      "title": "新装的 FreeBSD 上 pkg 还没初始化",
      "detail": "刚装好的系统执行 pkg 会报 'The package management tool is not yet installed on your system'，需要先 bootstrap（要有 root）。",
      "fix": "以 root 执行 pkg bootstrap（非交互：ASSUME_ALWAYS_YES=yes pkg bootstrap），之后 pkg update 再装包。"
    },
    {
      "id": "freebsd-no-sudo-su-c", "platforms": ["freebsd"],
      "title": "FreeBSD base 没有 sudo，且 su -c 不是执行命令",
      "detail": "base 既没有 sudo 也没有 doas（命令直接 127）。更坑的是从 Linux 照搬的 su -c 'cmd' 在 FreeBSD 上 -c 表示 login class，不是命令，会静默变成别的东西。",
      "fix": "提权用 su -（交互切到 root）或 pkg install sudo 后把用户加进 wheel 组（pw groupmod wheel -m 用户名）；也可以 pkg install doas 并写 /usr/local/etc/doas.conf。脚本里需要非交互 root 时用 sudo -n 或直接以 root 运行。"
    },
    {
      "id": "freebsd-third-party-layout", "platforms": ["freebsd"],
      "title": "FreeBSD 的第三方软件装在 /usr/local",
      "detail": "pkg 装的程序在 /usr/local/bin|sbin，配置在 /usr/local/etc，rc.d 服务脚本在 /usr/local/etc/rc.d，网页根目录在 /usr/local/www；base 的日志仍是 /var/log/messages、/var/log/auth.log。PATH 默认含 /usr/local/bin，但 cron 环境可能不含。",
      "fix": "写脚本用 #!/usr/local/bin/bash 这类绝对路径或显式 export PATH=/usr/local/bin:/usr/bin:/bin；服务用 service X start 前先 sysrc X_enable=YES 才会开机自启。"
    }
  ]
}
