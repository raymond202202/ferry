// ferry 映射库 — Shell 语法差异 + 跨平台已知坑（非命令，用于 prompt-export / syntax / pitfalls）
{
  "commands": [],
  "syntax": [
    {
      "id": "pipe", "summary": "管道", "status": "approximate",
      "linux": "cmd1 | cmd2", "macos": "cmd1 | cmd2",
      "windows": "cmd1 | cmd2", "windows_cmd": "cmd1 | cmd2",
      "note": "语法相同，但 PowerShell 管道传的是对象而非文本，grep/awk 式处理要换成 Where-Object / Select-Object"
    },
    {
      "id": "and-and", "summary": "顺序执行（前一个成功才继续）", "status": "approximate",
      "linux": "cmd1 && cmd2", "macos": "cmd1 && cmd2",
      "windows": "cmd1; if ($?) { cmd2 }", "windows_cmd": "cmd1 && cmd2",
      "note": "PowerShell 5.1 不支持 &&，PS7+ 才支持"
    },
    {
      "id": "or-or", "summary": "前一个失败才执行", "status": "approximate",
      "linux": "cmd1 || cmd2", "macos": "cmd1 || cmd2",
      "windows": "cmd1; if (-not $?) { cmd2 }", "windows_cmd": "cmd1 || cmd2",
      "note": "PowerShell 5.1 不支持 ||"
    },
    {
      "id": "semicolon", "summary": "顺序执行（忽略结果）", "status": "equivalent",
      "linux": "cmd1; cmd2", "macos": "cmd1; cmd2",
      "windows": "cmd1; cmd2", "windows_cmd": "cmd1 & cmd2"
    },
    {
      "id": "redirect-out", "summary": "重定向到文件", "status": "equivalent",
      "linux": "cmd > out.txt", "macos": "cmd > out.txt",
      "windows": "cmd > out.txt", "windows_cmd": "cmd > out.txt"
    },
    {
      "id": "redirect-err", "summary": "合并 stderr 到 stdout", "status": "equivalent",
      "linux": "cmd 2>&1", "macos": "cmd 2>&1",
      "windows": "cmd 2>&1", "windows_cmd": "cmd 2>&1"
    },
    {
      "id": "devnull", "summary": "丢弃输出", "status": "equivalent",
      "linux": "cmd > /dev/null 2>&1", "macos": "cmd > /dev/null 2>&1",
      "windows": "cmd > $null 2>&1", "windows_cmd": "cmd > NUL 2>&1"
    },
    {
      "id": "env-var", "summary": "引用环境变量", "status": "equivalent",
      "linux": "$FOO 或 ${FOO}", "macos": "$FOO 或 ${FOO}",
      "windows": "$env:FOO", "windows_cmd": "%FOO%"
    },
    {
      "id": "env-assign", "summary": "设置环境变量", "status": "equivalent",
      "linux": "export FOO=bar", "macos": "export FOO=bar",
      "windows": "$env:FOO = 'bar'", "windows_cmd": "set FOO=bar"
    },
    {
      "id": "cmd-subst", "summary": "命令替换", "status": "equivalent",
      "linux": "$(cmd) 或 `cmd`", "macos": "$(cmd) 或 `cmd`",
      "windows": "$(cmd)", "windows_cmd": "for /f %i in ('cmd') do ...",
      "note": "PowerShell 用 $( ) ，反引号在 PS 里是转义符不是命令替换"
    },
    {
      "id": "var-assign", "summary": "局部变量赋值", "status": "equivalent",
      "linux": "NAME=value", "macos": "NAME=value",
      "windows": "$Name = 'value'", "windows_cmd": "set NAME=value"
    },
    {
      "id": "exit-code", "summary": "上一条命令的退出码", "status": "equivalent",
      "linux": "$?", "macos": "$?",
      "windows": "$LASTEXITCODE（外部程序）/ $?（cmdlet 布尔）", "windows_cmd": "%ERRORLEVEL%"
    },
    {
      "id": "glob", "summary": "通配符展开", "status": "approximate",
      "linux": "*.log（shell 展开）", "macos": "*.log（shell 展开）",
      "windows": "*.log（多数 cmdlet 内部处理，非 shell 展开）", "windows_cmd": "*.log（程序自己处理）",
      "note": "POSIX 由 shell 展开后传给程序；Windows 多数情况由程序自己解释通配符"
    },
    {
      "id": "quoting", "summary": "引号与转义", "status": "approximate",
      "linux": "'literal' \"$expanded\" 反斜杠转义", "macos": "'literal' \"$expanded\" 反斜杠转义",
      "windows": "'literal' \"$expanded\" 反引号 ` 转义", "windows_cmd": "无单引号；双引号内 % 仍展开",
      "note": "PowerShell 单引号内不解析变量；反斜杠不是转义符，反引号才是"
    },
    {
      "id": "background", "summary": "后台执行", "status": "approximate",
      "linux": "cmd &", "macos": "cmd &",
      "windows": "Start-Job { cmd } 或 Start-Process", "windows_cmd": "start /b cmd"
    },
    {
      "id": "heredoc", "summary": "多行输入", "status": "unsupported",
      "linux": "cmd <<EOF ... EOF", "macos": "cmd <<EOF ... EOF",
      "windows": null, "windows_cmd": null,
      "note": "PowerShell 无 heredoc；用 here-string @\" ... \"@ 作为输入"
    },
    {
      "id": "subshell", "summary": "子 shell / 命令组", "status": "approximate",
      "linux": "( cmd1; cmd2 )", "macos": "( cmd1; cmd2 )",
      "windows": "& { cmd1; cmd2 }", "windows_cmd": "cmd /c \"cmd1 & cmd2\""
    },
    {
      "id": "brace-expand", "summary": "大括号扩展", "status": "unsupported",
      "linux": "cp a.{txt,bak}", "macos": "cp a.{txt,bak}（zsh 支持）",
      "windows": null, "windows_cmd": null,
      "note": "PowerShell 无大括号扩展；bash 支持，sh/dash 不支持"
    },
    {
      "id": "tilde", "summary": "家目录缩写 ~", "status": "equivalent",
      "linux": "~/app", "macos": "~/app",
      "windows": "~\\app（PS 支持）或 $env:USERPROFILE\\app", "windows_cmd": "%USERPROFILE%\\app"
    },
    {
      "id": "path-sep", "summary": "路径分隔符", "status": "approximate",
      "linux": "/", "macos": "/",
      "windows": "\\（PS 也接受 /）", "windows_cmd": "\\"
    },
    {
      "id": "case-sensitivity", "summary": "大小写敏感", "status": "approximate",
      "linux": "文件名敏感、命令名敏感", "macos": "文件名默认不敏感（APFS）、命令名敏感",
      "windows": "文件名不敏感、命令名不敏感", "windows_cmd": "均不敏感",
      "note": "跨平台脚本里文件名一律按敏感处理最安全"
    },
    {
      "id": "line-ending", "summary": "行尾符", "status": "unsupported",
      "linux": "LF", "macos": "LF",
      "windows": "CRLF", "windows_cmd": "CRLF",
      "note": "CRLF 的 .sh 在 Linux 上会报 bad interpreter: /bin/bash^M，用 dos2unix 或 sed -i 's/\\r//' 修"
    },
    {
      "id": "encoding", "summary": "默认编码", "status": "approximate",
      "linux": "UTF-8", "macos": "UTF-8",
      "windows": "PS 5.1 默认 ANSI(GBK)/ 输出 UTF-16；PS7 默认 UTF-8", "windows_cmd": "OEM 代码页（中文 936）",
      "note": "Windows 上读写中文必设 [Console]::OutputEncoding = [Text.UTF8Encoding]::new() 或 chcp 65001"
    },
    {
      "id": "sudo", "summary": "提权执行", "status": "approximate",
      "linux": "sudo cmd", "macos": "sudo cmd",
      "windows": "Start-Process -Verb RunAs", "windows_cmd": "runas /user:Administrator cmd",
      "note": "Windows 无 sudo（Win11 24H2 起有 sudo 但默认关闭）；多数操作需管理员终端"
    }
  ],
  "pitfalls": [
    {
      "id": "bsd-sed-inplace", "platforms": ["macos"],
      "title": "BSD sed 的 -i 必须带备份后缀",
      "detail": "macOS 的 sed 来自 BSD，`sed -i 's/a/b/' f` 会把 's/a/b/' 当成备份后缀，报错或产生垃圾文件。",
      "fix": "写成 sed -i '' 's/a/b/' f（空串=不备份）；或 brew install gnu-sed 后用 gsed。"
    },
    {
      "id": "macos-missing-tools", "platforms": ["macos"],
      "title": "macOS 默认缺少一批 GNU 工具",
      "detail": "timeout、watch、free、nproc、sha256sum、md5sum、wget、tree、column、realpath(旧版) 都不存在或有差异。",
      "fix": "brew install coreutils findutils gnu-sed grep gawk watch wget tree moreutils，GNU 版带 g 前缀（gtimeout/gnproc/gsort）。"
    },
    {
      "id": "bash-32-macos", "platforms": ["macos"],
      "title": "macOS 自带 bash 是 3.2（2007 年）",
      "detail": "不支持关联数组、${var,,}、mapfile；默认 shell 是 zsh。脚本写 #!/bin/bash 在 macOS 上行为可能不同。",
      "fix": "脚本用 #!/usr/bin/env bash 并在需要时 brew install bash；或统一按 POSIX sh 写。"
    },
    {
      "id": "gnu-grep-p", "platforms": ["macos"],
      "title": "BSD grep 不支持 -P（PCRE）",
      "detail": "grep -P '\\d+' 在 macOS 报错。BSD grep 也不支持 --include 的某些写法。",
      "fix": "brew install grep 后用 ggrep -P；或改用 grep -E 的 POSIX 正则。"
    },
    {
      "id": "stat-dialect", "platforms": ["macos", "linux"],
      "title": "stat 参数两套方言",
      "detail": "Linux: stat -c '%s' f；macOS: stat -f '%z' f。互相照抄必然失败。",
      "fix": "按平台分支写；跨平台脚本用 python3 -c 'import os,sys;print(os.path.getsize(sys.argv[1]))'。"
    },
    {
      "id": "date-d", "platforms": ["macos"],
      "title": "BSD date 没有 -d",
      "detail": "date -d '2026-01-01' +%s 在 macOS 无效。",
      "fix": "macOS 用 date -j -f '%Y-%m-%d' '2026-01-01' +%s。"
    },
    {
      "id": "readlink-f", "platforms": ["macos"],
      "title": "BSD readlink 没有 -f",
      "detail": "readlink -f 在 macOS 不可用（旧版本）。",
      "fix": "用 realpath（10.13+，需 sw_vers 确认）或 perl -MCwd -e 'print abs_path($ARGV[0])'。"
    },
    {
      "id": "sort-v", "platforms": ["macos"],
      "title": "sort -V 依赖系统版本",
      "detail": "旧版 BSD sort 不认识 -V（illegal option）；macOS 15+ 实测支持（GitHub Actions macOS runner 通过）。",
      "fix": "先直接试 sort -V；报错再 brew install coreutils 用 gsort -V，或在脚本里自己解析。"
    },
    {
      "id": "cp-a-macos", "platforms": ["macos"],
      "title": "旧版 macOS 的 cp 不支持 -a",
      "detail": "cp -a（归档模式）在 macOS 13 之前不被支持。",
      "fix": "用 cp -R -p；或 ditto（macOS 原生，保留元数据）。"
    },
    {
      "id": "ps51-andand", "platforms": ["windows"],
      "title": "PowerShell 5.1 不支持 && 和 ||",
      "detail": "Windows 自带的是 PS 5.1，&& 会报 ParserError；PS7+ 才支持。",
      "fix": "用 ; if ($?) { ... } 结构，或安装 PowerShell 7 并显式用 pwsh。"
    },
    {
      "id": "ps-param-abbrev", "platforms": ["windows"],
      "title": "PowerShell 参数可缩写、不区分大小写",
      "detail": "-Rec 会被解析为 -Recurse，-f 可能歧义报错。命令名大小写也不敏感。",
      "fix": "脚本里参数写全称，避免缩写带来的歧义。"
    },
    {
      "id": "win-encoding", "platforms": ["windows"],
      "title": "Windows 控制台编码不是 UTF-8",
      "detail": "PS 5.1 默认按 ANSI 解码外部程序输出，中文会乱码；重定向文件可能变 UTF-16。",
      "fix": "[Console]::OutputEncoding=[Text.UTF8Encoding]::new(); $OutputEncoding=[Text.UTF8Encoding]::new()；或 chcp 65001。"
    },
    {
      "id": "win-path-limit", "platforms": ["windows"],
      "title": "Windows 路径 260 字符限制",
      "detail": "深目录/长文件名会报 PathTooLongException（除非启用 LongPathsEnabled）。",
      "fix": "注册表 HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem\\LongPathsEnabled=1，或用 \\\\?\\ 前缀。"
    },
    {
      "id": "win-invalid-chars", "platforms": ["windows"],
      "title": "NTFS 禁用字符与保留名",
      "detail": ": * ? \" < > | 不能出现在文件名；CON/PRN/AUX/NUL/COM1 是保留名。",
      "fix": "生成文件名前做白名单过滤。"
    },
    {
      "id": "rm-no-trash", "platforms": ["windows", "linux"],
      "title": "命令行删除不进回收站",
      "detail": "rm -rf / Remove-Item -Recurse -Force 都是永久删除，不可恢复。",
      "fix": "危险操作前先 dry-run 打印命中列表；或 Windows 用 Recycle 模块，Linux 用 trash-cli。"
    },
    {
      "id": "symlink-perm", "platforms": ["windows"],
      "title": "Windows 符号链接需权限",
      "detail": "New-Item -ItemType SymbolicLink 需管理员权限或开启开发者模式；mklink 参数顺序与 ln 相反。",
      "fix": "开启开发者模式，或以管理员运行；顺序是 mklink 链接 目标。"
    },
    {
      "id": "crlf-script", "platforms": ["linux", "macos", "windows"],
      "title": "CRLF 破坏 shell 脚本",
      "detail": "Windows 编辑过的 .sh 在 Linux 报 /bin/bash^M: bad interpreter。",
      "fix": "git config core.autocrlf input；已有文件用 dos2unix 或 sed -i 's/\\r$//'。"
    },
    {
      "id": "zsh-default", "platforms": ["macos"],
      "title": "macOS 默认 shell 是 zsh",
      "detail": "写进 ~/.bashrc 的别名/环境变量在 zsh 里不生效；zsh 也不做无引号变量分词。",
      "fix": "macOS 上写 ~/.zshrc；两者都要兼容就抽到 ~/.profile 并在两个 rc 里 source。"
    },
    {
      "id": "service-models", "platforms": ["linux", "macos", "windows"],
      "title": "三套完全不同的服务模型",
      "detail": "Linux=systemd unit；macOS=launchd plist（brew services 是包装）；Windows=SCM 服务。没有通用命令。",
      "fix": "分别用 systemctl / launchctl(bootstrap) / New-Service+sc.exe；跨平台产品自带安装器时优先用它注册服务。"
    },
    {
      "id": "wsl-paths", "platforms": ["windows"],
      "title": "WSL 与原生 Windows 路径互转",
      "detail": "WSL 里 C:\\Users → /mnt/c/Users；Linux 侧 / 不等于 Windows 的 C:\\。",
      "fix": "用 wslpath -a/-u 转换；ferry translate 加 --path-style wsl|msys 控制反向映射写法。"
    },
    {
      "id": "hidden-files", "platforms": ["windows", "linux"],
      "title": "隐藏文件机制不同",
      "detail": "POSIX 靠文件名前缀点号；Windows 靠文件属性（Hidden），ls -a 与 Get-ChildItem -Force 不等价。",
      "fix": "Windows 上还得看 attributes；跨平台遍历时两边都显式包含。"
    },
    {
      "id": "case-fs", "platforms": ["macos", "windows"],
      "title": "文件系统默认大小写不敏感",
      "detail": "macOS(APFS 默认)/Windows 上 Foo.txt 与 foo.txt 是同一个文件，Linux 上是两个。",
      "fix": "发布脚本注意撞名；CI 在 Linux 上跑能提前暴露问题。"
    }
  ]
}
